{
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all --check)",
      "Bash(cargo fmt --check)",
      "Bash(osv-scanner scan *)",
      "Bash(bash -n *)",
      "Bash(sqlx --version)",
      "Bash(rustc --version)",
      "Bash(cargo tree *)",
      "Bash(cargo info *)",
      "Bash(cargo metadata *)",
      "Bash(docker buildx imagetools inspect *)",
      "Bash(shellcheck *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo run -p rs-backend *)",
      "Bash(cargo deny *)",
      "Bash(cargo audit *)",
      "Bash(cargo sqlx prepare *)",
      "Bash(gitleaks *)",
      "Bash(bash scripts/verify.sh)",
      "Bash(bash scripts/db-roles-check.sh *)",
      "Bash(bash scripts/db-migrations-check.sh)",
      "Bash(bash scripts/test/test-verify.sh)",
      "Bash(docker compose -f infra/local/compose.yaml *)",
      "Bash(docker run --rm *)",
      "Bash(docker stop *)",
      "Bash(docker pull *)",
      "Bash(psql *)",
      "Bash(sqlx migrate *)",
      "Bash(pnpm install *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm tsc *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint *)",
      "Bash(npm view *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git worktree *)",
      "Bash(mkdir -p /tmp/claude-1000/*)",
      "Bash(cp -r * /tmp/claude-1000/*)",
      "Bash(cp * /tmp/claude-1000/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Edit(./.githooks/**)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath *)"
    ],
    "ask": [
      "Edit(./scripts/verify.sh)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-before-stop.sh"
          }
        ]
      }
    ]
  }
}
