{
  "permissions": {
    "allow": [
      "Bash(cargo fmt --all --check)",
      "Bash(cargo fmt --check)",
      "Bash(osv-scanner scan *)",
      "Bash(bash -n *)",
      "Bash(sqlx --version)",
      "Bash(rustc --version)",
      "Bash(cargo tree *)",
      "Bash(cargo info *)",
      "Bash(cargo metadata *)",
      "Bash(docker buildx imagetools inspect *)",
      "Bash(shellcheck *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Edit(./.githooks/**)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath *)"
    ],
    "ask": [
      "Edit(./scripts/verify.sh)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-before-stop.sh"
          }
        ]
      }
    ]
  }
}
