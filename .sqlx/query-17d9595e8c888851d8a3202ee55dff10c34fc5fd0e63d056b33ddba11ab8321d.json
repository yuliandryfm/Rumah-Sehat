  "query": "SELECT r.id AS request_id, d.nik_bidx, d.nik_bidx_key_version, d.nik_last4 FROM app.identity_verification_request r JOIN app.identity_verification_request_state s ON s.identity_verification_request_id = r.id JOIN app.identity_document d ON d.id = r.identity_document_id WHERE r.care_recipient_id = $1 AND r.id <> $2 AND s.status <> 'cancelled' ORDER BY r.created_at DESC, r.id DESC LIMIT 1",
