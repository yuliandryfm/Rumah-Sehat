  "query": "SELECT r.care_recipient_id, cr.is_account_owner, p.account_id AS owner_account_id, d.id AS document_id, d.nik_enc, d.data_key_id, d.file_id FROM app.identity_verification_request r JOIN app.identity_document d ON d.id = r.identity_document_id JOIN app.care_recipient cr ON cr.id = r.care_recipient_id JOIN app.patient p ON p.id = cr.patient_id WHERE r.id = $1 AND cr.deleted_at IS NULL AND p.deleted_at IS NULL AND d.deleted_at IS NULL",
