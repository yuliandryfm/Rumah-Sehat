{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.created_at, c.updated_at, c.deleted_at, c.delete_reason, c.content_type, c.title, c.body, c.category, c.image_file_id, c.image_alt_text, c.link_target_type, c.link_target_ref, c.publish_start_at, c.publish_end_at, c.editorial_status, c.channel, c.site_page FROM app.cms_content c WHERE c.channel IN ('site', 'app_and_site') AND c.editorial_status = 'scheduled' AND c.deleted_at IS NULL AND c.publish_start_at <= $1 AND (c.publish_end_at IS NULL OR c.publish_end_at > $1) AND ($2::text IS NULL OR c.site_page = $2) AND ($3::text IS NULL OR c.content_type = $3) AND ($4::uuid IS NULL OR (c.publish_start_at, c.id) < (SELECT p.publish_start_at, p.id FROM app.cms_content p WHERE p.id = $4 AND p.channel IN ('site', 'app_and_site') AND p.editorial_status = 'scheduled' AND p.deleted_at IS NULL AND p.publish_start_at <= $1 AND (p.publish_end_at IS NULL OR p.publish_end_at > $1))) ORDER BY c.publish_start_at DESC, c.id DESC LIMIT $5",
