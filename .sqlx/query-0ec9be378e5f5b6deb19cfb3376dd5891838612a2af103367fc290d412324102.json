{
  "db_name": "PostgreSQL",
  "query": "WITH next AS ( SELECT id FROM app.job WHERE status = 'queued' AND run_at <= $1 AND job_type = ANY($2::text[]) ORDER BY run_at, id LIMIT $3 FOR UPDATE SKIP LOCKED ) UPDATE app.job j SET status = 'running', locked_by = $4, locked_until = $5, attempt_count = j.attempt_count + 1 FROM next WHERE j.id = next.id RETURNING j.id, j.job_type, j.payload, j.run_at, j.attempt_count, j.max_attempts, j.dedupe_key",
