  "query": "SELECT c.id, c.legal_name, c.nib, c.origin, c.submission_round, c.submitted_at FROM app.corporate_client c WHERE c.deleted_at IS NULL AND c.status = 'pending_verification' AND ($1::uuid IS NULL OR (c.submitted_at, c.id) > (SELECT a.submitted_at, a.id FROM app.corporate_client a WHERE a.id = $1)) ORDER BY c.submitted_at, c.id LIMIT $2",
