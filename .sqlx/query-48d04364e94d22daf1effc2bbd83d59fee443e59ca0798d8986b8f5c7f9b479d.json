  "query": "SELECT f.id AS stored_file_id, f.bucket, f.object_key, f.category, f.mime_type, f.size_bytes, f.sha256, f.owner_account_id, f.container_type FROM app.corporate_client_document d JOIN app.stored_file f ON f.id = d.stored_file_id WHERE d.corporate_client_id = $1 AND d.document_kind = $2 AND d.deleted_at IS NULL AND f.deleted_at IS NULL",
