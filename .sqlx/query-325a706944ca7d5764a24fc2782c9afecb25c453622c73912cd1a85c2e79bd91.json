{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id AS request_id, r.care_recipient_id, r.trigger_type, r.created_at AS submitted_at, d.id AS document_id, d.document_type, d.nik_enc, d.data_key_id, cr.full_name, cr.birth_date, cr.sex, cr.is_account_owner, p.account_id AS owner_account_id, s.status, e.reason_code, e.created_at AS status_changed_at FROM app.identity_verification_request r JOIN app.identity_verification_request_state s ON s.identity_verification_request_id = r.id JOIN app.identity_verification_request_status_event e ON e.identity_verification_request_id = r.id AND e.version = s.version JOIN app.identity_document d ON d.id = r.identity_document_id JOIN app.care_recipient cr ON cr.id = r.care_recipient_id JOIN app.patient p ON p.id = cr.patient_id WHERE r.id = $1 AND cr.deleted_at IS NULL AND p.deleted_at IS NULL AND d.deleted_at IS NULL",
