{
  "db_name": "PostgreSQL",
  "query": "SELECT id, created_at, updated_at, deleted_at, delete_reason, content_type, title, body, category, image_file_id, image_alt_text, link_target_type, link_target_ref, publish_start_at, publish_end_at, editorial_status, channel, site_page FROM app.cms_content WHERE (CASE WHEN $1::text = 'deleted' THEN deleted_at IS NOT NULL ELSE deleted_at IS NULL AND ( $1::text IS NULL OR ($1::text = 'draft' AND editorial_status = 'draft') OR ($1::text = 'archived' AND editorial_status = 'archived') OR ($1::text = 'scheduled' AND editorial_status = 'scheduled' AND publish_start_at > $2) OR ($1::text = 'live' AND editorial_status = 'scheduled' AND publish_start_at <= $2 AND (publish_end_at IS NULL OR publish_end_at > $2)) OR ($1::text = 'ended' AND editorial_status = 'scheduled' AND publish_end_at <= $2)) END) AND ($3::text IS NULL OR channel = $3) AND ($4::text IS NULL OR site_page = $4) AND ($5::uuid IS NULL OR id < $5) ORDER BY id DESC LIMIT $6",
