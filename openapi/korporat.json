  "components": {
    "schemas": {
      "CorporateNameValueDto": {
        "type": "object",
        "description": "Pasangan nama-nilai (field formulir POST atau header PUT). Nilainya bagian dari tanda tangan URL unggah\n(rahasia berumur pendek): tanpa `Debug` (KEPUTUSAN-122).",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "CorporateUploadMethodDto": {
        "type": "string",
        "description": "Cara unggah langsung ke object storage.",
        "enum": [
          "post",
          "put"
        ]
      },
      "CorporateUploadSlotDto": {
        "type": "object",
        "description": "Slot unggah yang diterbitkan. `url`, `fields`, dan `headers` rahasia berumur pendek: `Debug` manual\nmenyamarkannya (KEPUTUSAN-122).",
        "required": [
          "upload_slot_id",
          "expires_at",
          "method",
          "url",
          "fields",
          "headers"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CorporateNameValueDto"
            },
            "description": "Field formulir (POST); kosong untuk PUT."
          },
          "headers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CorporateNameValueDto"
            },
            "description": "Header wajib (PUT); kosong untuk POST."
          },
          "method": {
            "$ref": "#/components/schemas/CorporateUploadMethodDto"
          },
          "upload_slot_id": {
            "type": "string",
            "example": "0193a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "CorporateUploadSlotEnvelope": {
        "type": "object",
        "description": "Bentuk dokumentasi respons slot unggah.",
        "required": [
          "response_code",
          "response_description",
          "data"
        ],
        "properties": {
          "correlation_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CorporateUploadSlotDto"
          },
          "response_code": {
            "type": "string",
            "example": "2010000"
          },
          "response_description": {
            "type": "string",
            "example": "Berhasil dibuat"
          }
        }
      },
      "DocumentConfirmRequest": {
        "type": "object",
        "description": "Konfirmasi unggahan dokumen.",
        "required": [
          "document_kind",
          "upload_slot_id"
        ],
        "properties": {
          "document_kind": {
            "$ref": "#/components/schemas/DocumentKindDto"
          },
          "upload_slot_id": {
            "type": "string",
            "description": "ID slot dari `POST /v1/corporate/document-upload-slots` yang berkasnya sudah diunggah.",
            "example": "0193a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b"
          }
        },
        "additionalProperties": false
      },
      "DocumentDownloadRequest": {
        "type": "object",
        "description": "Permintaan URL unduh dokumen perusahaan sendiri.",
        "required": [
          "document_kind"
        ],
        "properties": {
          "document_kind": {
            "$ref": "#/components/schemas/DocumentKindDto"
          }
        },
        "additionalProperties": false
      },
      "DocumentKindDto": {
        "type": "string",
        "description": "Jenis dokumen wajib perusahaan.",
        "enum": [
          "nib",
          "npwp",
          "authority_proof"
        ]
      },
      "DocumentSlotRequest": {
        "type": "object",
        "description": "Permintaan slot unggah dokumen.",
        "required": [
          "content_type",
          "size_bytes"
        ],
        "properties": {
          "content_type": {
            "type": "string",
            "description": "Jenis yang dinyatakan: `image/jpeg`, `image/png`, atau `application/pdf` (isi tetap diperiksa saat\nkonfirmasi; ekstensi dan header tidak dipercaya).",
            "example": "application/pdf"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Ukuran berkas (byte): maksimal 5.242.880 untuk foto dan 10.485.760 untuk PDF (NFR-SEC-08).",
            "example": 204800,
            "maximum": 10485760,
            "minimum": 1
          }
