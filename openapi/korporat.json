{
  "openapi": "3.1.0",
  "info": {
    "title": "Ruang Sehat: API korporat",
    "description": "Endpoint member area HR perusahaan (realm korporat, akun HR dengan keanggotaan aktif; data perusahaan lain dijawab 404, ADR-028 butir 1). Format respons: ADR-023.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/corporate/document-download-urls": {
      "post": {
        "tags": [
          "corporate-documents"
        ],
        "summary": "URL unduh berumur pendek (5 menit) untuk dokumen perusahaan pemanggil sendiri. Dicatat E-12 sebelum URL\nterbit.",
        "operationId": "corporate_document_download_url_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentDownloadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "URL unduh berumur pendek.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUrlEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Badan permintaan tidak dapat dibaca.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Belum login, token tidak sah, sesi dicabut, akun atau perusahaan nonaktif, atau keanggotaan dicabut.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Dokumen jenis itu belum diunggah.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "4090112: perusahaan sudah Aktif; dokumen hanya dikelola saat menunggu verifikasi atau ditolak.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Badan bukan application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Jenis dokumen tidak valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Galat internal, termasuk pencatatan audit gagal (tanpa URL).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Layanan tidak tersedia.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/corporate/document-upload-slots": {
      "post": {
        "tags": [
          "corporate-documents"
        ],
        "summary": "Slot unggah dokumen perusahaan (langkah 1 dari 3): berkas diunggah langsung ke object storage, lalu\ndikonfirmasi lewat `POST /v1/corporate/documents`. JPG/PNG paling besar 5.242.880 byte atau PDF paling besar\n10.485.760 byte.",
        "operationId": "corporate_document_upload_slot_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentSlotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Slot unggah diterbitkan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorporateUploadSlotEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Badan permintaan tidak dapat dibaca.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Belum login, token tidak sah, sesi dicabut, akun atau perusahaan nonaktif, atau keanggotaan dicabut.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "4090112: perusahaan sudah Aktif; dokumen hanya dikelola saat menunggu verifikasi atau ditolak.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Ukuran melebihi 5.242.880 byte (foto) atau 10.485.760 byte (PDF).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Jenis bukan image/jpeg, image/png, atau application/pdf, PDF belum didukung server, atau badan bukan JSON.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Isian tidak valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Kuota slot unggah per akun terlampaui (4290001).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Layanan tidak tersedia.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
