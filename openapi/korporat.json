    "/v1/corporate/members/{corporate_member_id}/deactivate": {
      "post": {
        "tags": [
          "corporate-hr"
        ],
        "summary": "Menonaktifkan HR lain di perusahaan pemanggil (US-1904 AC2, AC5): keanggotaan dicabut dan akun\nnonaktif; permintaan berikutnya HR itu langsung ditolak.",
        "operationId": "corporate_member_deactivate",
        "parameters": [
          {
            "name": "corporate_member_id",
            "in": "path",
            "description": "ID keanggotaan HR (UUID).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dinonaktifkan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HrDeactivatedEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Belum login, token tidak sah, sesi dicabut, akun atau perusahaan nonaktif, atau keanggotaan dicabut (termasuk pemanggil yang baru saja dinonaktifkan HR lain).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Perusahaan belum Aktif (menunggu verifikasi atau ditolak).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Keanggotaan tidak ada, sudah dicabut, atau milik perusahaan lain.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "4090101: HR menonaktifkan dirinya sendiri. 4090105: HR aktif terakhir perusahaan. 4090001: akun sudah nonaktif.",
