{
  "openapi": "3.1.0",
  "info": {
    "title": "Ruang Sehat: API backoffice",
    "description": "Endpoint backoffice admin Ruang Sehat (realm admin, sub-peran per endpoint, UP-18). Format respons: ADR-023.",
    "version": "0.1.0"
  },
  "paths": {
    "/backoffice/v1/contents": {
      "get": {
        "tags": [
          "cms"
        ],
        "summary": "Daftar konten dengan saringan status, kanal, dan halaman situs (wireframe C14).",
        "operationId": "cms_content_list",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Status tampilan; `deleted` menampilkan konten terhapus yang dapat dipulihkan.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DisplayStatus"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Kanal.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          {
            "name": "site_page",
            "in": "query",
            "description": "Halaman situs.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SitePage"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Cursor dari `meta.next_cursor` halaman sebelumnya.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Jumlah item (1-100, bawaan 20).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar konten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Belum login, token tidak sah, atau akun nonaktif.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Akun tanpa sub-peran Konten.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Saringan tidak valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Layanan tidak tersedia.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "cms"
        ],
        "summary": "Membuat konten baru berstatus Draf (US-1101 AC1).",
        "operationId": "cms_content_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Draf dibuat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Badan permintaan tidak dapat dibaca.",
