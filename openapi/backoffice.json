  "components": {
    "schemas": {
      "Channel": {
        "type": "string",
        "description": "Kanal tayang (`ck_cms_content_channel`).",
        "enum": [
          "app",
          "site",
          "app_and_site"
        ]
      },
      "ContentDto": {
        "type": "object",
        "description": "Konten di backoffice (termasuk isi untuk pratinjau, US-1101 AC1).",
        "required": [
          "content_id",
          "content_type",
          "title",
          "channel",
          "editorial_status",
          "display_status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "content_id": {
            "type": "string",
            "example": "0193a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b"
          },
          "content_type": {
            "$ref": "#/components/schemas/ContentType"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "delete_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "display_status": {
            "$ref": "#/components/schemas/DisplayStatus",
            "description": "Status tampilan menurut jam server (Draf, Tayang (terjadwal), Tayang, Selesai, Diarsipkan, Terhapus)."
          },
          "editorial_status": {
            "$ref": "#/components/schemas/EditorialStatus",
            "description": "Status tersimpan."
          },
          "image_alt_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_file_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID berkas gambar (bucket konten publik, disajikan lewat endpoint gambar publik bila tayang).",
            "example": "0193a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b"
          },
          "link_target_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "link_target_type": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LinkTargetType"
              },
              {
                "type": "null"
              }
            ]
          },
          "publish_end_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "publish_start_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "site_page": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SitePage"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContentEnvelope": {
        "type": "object",
        "description": "Bentuk dokumentasi respons sukses satu konten (ADR-023 butir 1); isi sebenarnya `envelope::Success`.",
        "required": [
          "response_code",
          "response_description",
          "data"
        ],
        "properties": {
          "correlation_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ContentDto"
          },
          "response_code": {
            "type": "string",
            "example": "2000000"
          },
          "response_description": {
            "type": "string",
            "example": "Berhasil"
          }
        }
      },
      "ContentListEnvelope": {
        "type": "object",
        "description": "Bentuk dokumentasi respons daftar konten.",
        "required": [
          "response_code",
          "response_description",
          "data",
          "meta"
        ],
        "properties": {
          "correlation_id": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/MetaSchema"
          },
          "response_code": {
            "type": "string",
            "example": "2000000"
          },
          "response_description": {
            "type": "string",
            "example": "Berhasil"
          }
        }
      },
      "ContentRequest": {
        "type": "object",
        "description": "Isian simpan draf (buat atau ubah).",
        "required": [
          "content_type",
          "title",
          "channel"
        ],
        "properties": {
          "body": {
            "type": [
              "string",
              "null"
            ],
            "description": "Isi Markdown tanpa HTML mentah (US-1802 AC6).",
            "maxLength": 100000
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "Kategori (opsional).",
            "maxLength": 100
          },
          "channel": {
            "$ref": "#/components/schemas/Channel",
            "description": "Kanal tayang: aplikasi, situs, atau keduanya (US-1802 AC1)."
          },
          "content_type": {
            "$ref": "#/components/schemas/ContentType",
            "description": "Jenis konten."
          },
          "image_alt_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Teks alternatif gambar; wajib sebelum konten bergambar ditayangkan (US-1802 AC5).",
            "maxLength": 300
          },
          "link_target_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Rujukan tujuan tautan.",
            "maxLength": 500
          },
          "link_target_type": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LinkTargetType",
                "description": "Tujuan tautan banner."
              },
              {
                "type": "null"
              }
            ]
          },
          "site_page": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SitePage",
                "description": "Halaman situs tujuan; wajib bila kanal memuat situs."
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "description": "Judul (1-200 karakter).",
            "example": "Tentang Ruang Sehat",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "ContentType": {
        "type": "string",
        "description": "Jenis konten (`ck_cms_content_content_type`).",
        "enum": [
          "banner",
          "info_page",
          "article",
          "promo"
        ]
      },
      "DeleteRequest": {
        "type": "object",
        "description": "Soft delete dengan alasan wajib (ADR-003).",
        "required": [
          "delete_reason"
        ],
        "properties": {
          "delete_reason": {
            "type": "string",
            "description": "Alasan penghapusan (1-500 karakter).",
            "example": "Konten usang",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      },
      "DeletedDto": {
        "type": "object",
        "description": "Hasil soft delete.",
        "required": [
          "content_id",
          "display_status"
        ],
        "properties": {
          "content_id": {
            "type": "string",
            "example": "0193a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b"
          },
          "display_status": {
            "$ref": "#/components/schemas/DisplayStatus"
          }
        }
      },
      "DeletedEnvelope": {
        "type": "object",
        "description": "Bentuk dokumentasi respons soft delete.",
        "required": [
          "response_code",
          "response_description",
          "data"
        ],
        "properties": {
          "correlation_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/DeletedDto"
          },
          "response_code": {
            "type": "string",
            "example": "2000000"
          },
          "response_description": {
            "type": "string",
            "example": "Berhasil"
          }
        }
      },
      "DisplayStatus": {
        "type": "string",
        "description": "Status tampilan yang dihitung (wireframe C14: Draf, Tayang (terjadwal), Tayang, Selesai, Diarsipkan,\nTerhapus).",
        "enum": [
          "draft",
          "scheduled",
          "live",
          "ended",
          "archived",
          "deleted"
        ]
      },
      "EditorialStatus": {
        "type": "string",
        "description": "Status editorial tersimpan (`ck_cms_content_editorial_status`).",
        "enum": [
          "draft",
          "scheduled",
          "archived"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "Bentuk dokumentasi respons galat (RFC 9457 yang kompatibel dengan ADR-023 butir 3). Isi sebenarnya\ndibangun `envelope::ErrorBody`; test `tests/openapi_schema_drift.rs` menjaga keduanya sama.",
        "required": [
          "type",
          "response_code",
          "response_description",
          "correlation_id"
        ],
        "properties": {
          "correlation_id": {
            "type": "string",
            "description": "UUID korelasi permintaan; selalu ada pada galat.",
            "example": "01936f8e-9c01-7e02-8f03-1a2b3c4d5e6f"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorSchema"
            },
            "description": "Galat per isian; hanya pada galat validasi."
          },
          "instance": {
            "type": "string",
            "description": "Pola rute (bukan URL dengan ID)."
          },
          "response_code": {
            "type": "string",
            "description": "Kode 7 digit `HHHMMCC` (docs/05-response-codes.md).",
            "example": "4040001"
          },
          "response_description": {
            "type": "string",
            "description": "Deskripsi Bahasa Indonesia untuk kode itu.",
            "example": "Data tidak ditemukan"
          },
          "type": {
            "type": "string",
            "description": "URI jenis masalah: `<awalan>/<response_code>`.",
            "example": "https://problems.ruang-sehat.invalid/4040001"
          }
        }
      },
      "FieldErrorSchema": {
        "type": "object",
        "description": "Satu galat per isian (`errors[]`), sama dengan `envelope::FieldError`.",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Kode galat isian, snake_case Inggris.",
            "example": "invalid_format"
          },
          "field": {
            "type": "string",
            "description": "Path isian.",
            "example": "email"
          },
          "message": {
            "type": "string",
            "description": "Pesan Bahasa Indonesia untuk pengguna.",
            "example": "Format email tidak valid"
          }
        }
      },
      "LinkTargetType": {
        "type": "string",
        "description": "Tujuan tautan banner (`ck_cms_content_link_target_type`).",
        "enum": [
          "article",
          "service",
          "partner",
          "product"
        ]
      },
      "MetaSchema": {
        "type": "object",
        "description": "Pagination cursor `meta` (ADR-023 butir 1), sama dengan `envelope::Meta`.",
        "required": [
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean",
            "description": "Apakah masih ada data setelah halaman ini."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor halaman berikutnya; `null` bila tidak ada."
          }
        }
      },
      "ScheduleRequest": {
        "type": "object",
        "description": "Jadwal tayang (US-1101 AC2). Tanpa `publish_start_at` = tayang sekarang menurut jam server.",
        "properties": {
          "publish_end_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Waktu selesai tayang (opsional), ISO 8601 dengan offset; harus setelah waktu mulai."
          },
          "publish_start_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Waktu mulai tayang, ISO 8601 dengan offset; tidak boleh di masa lalu.",
            "example": "2027-03-01T08:00:00+07:00"
          }
        },
        "additionalProperties": false
      },
      "SitePage": {
        "type": "string",
        "description": "Halaman situs tujuan (BR-130, `ck_cms_content_site_page`).",
        "enum": [
          "home",
          "about",
          "services",
          "for_business",
          "partners",
          "articles",
          "contact",
          "download_app",
          "privacy_terms"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "cms",
      "description": "Konten (CMS) aplikasi dan situs"
    }
  ]
}
