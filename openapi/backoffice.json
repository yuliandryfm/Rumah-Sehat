        "enum": [
          "draft",
          "scheduled",
          "archived"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "Bentuk dokumentasi respons galat (RFC 9457 yang kompatibel dengan ADR-023 butir 3). Isi sebenarnya\ndibangun `envelope::ErrorBody`; test `tests/openapi_schema_drift.rs` menjaga keduanya sama.",
        "required": [
          "type",
          "response_code",
          "response_description",
          "correlation_id"
        ],
        "properties": {
          "correlation_id": {
            "type": "string",
            "description": "UUID korelasi permintaan; selalu ada pada galat.",
            "example": "01936f8e-9c01-7e02-8f03-1a2b3c4d5e6f"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorSchema"
            },
            "description": "Galat per isian; hanya pada galat validasi."
          },
          "instance": {
            "type": "string",
            "description": "Pola rute (bukan URL dengan ID)."
          },
          "response_code": {
            "type": "string",
            "description": "Kode 7 digit `HHHMMCC` (docs/05-response-codes.md).",
            "example": "4040001"
          },
          "response_description": {
            "type": "string",
            "description": "Deskripsi Bahasa Indonesia untuk kode itu.",
            "example": "Data tidak ditemukan"
          },
          "type": {
            "type": "string",
            "description": "URI jenis masalah: `<awalan>/<response_code>`.",
            "example": "https://problems.ruang-sehat.invalid/4040001"
          }
        }
      },
      "FieldErrorSchema": {
        "type": "object",
        "description": "Satu galat per isian (`errors[]`), sama dengan `envelope::FieldError`.",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Kode galat isian, snake_case Inggris.",
            "example": "invalid_format"
          },
          "field": {
            "type": "string",
            "description": "Path isian.",
            "example": "email"
          },
          "message": {
            "type": "string",
            "description": "Pesan Bahasa Indonesia untuk pengguna.",
            "example": "Format email tidak valid"
          }
        }
      },
      "ImageSlotRequest": {
        "type": "object",
        "description": "Permintaan slot unggah gambar konten.",
        "required": [
          "content_type",
          "size_bytes"
        ],
        "properties": {
          "content_type": {
            "type": "string",
            "description": "Jenis yang dinyatakan: `image/jpeg` atau `image/png` (isi tetap diperiksa setelah unggah).",
            "example": "image/png"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Ukuran berkas (byte), maksimal 5 MiB (NFR-SEC-08).",
            "example": 204800,
            "maximum": 5242880,
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
