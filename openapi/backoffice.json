            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ContentDto"
          },
          "response_code": {
            "type": "string",
            "example": "2000000"
          },
          "response_description": {
            "type": "string",
            "example": "Berhasil"
          }
        }
