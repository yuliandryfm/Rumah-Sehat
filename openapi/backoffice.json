        "enum": [
          "post",
          "put"
        ]
      },
      "UploadSlotDto": {
        "type": "object",
        "description": "Slot unggah yang diterbitkan.",
        "required": [
          "upload_slot_id",
          "expires_at",
          "method",
          "url",
          "fields",
          "headers"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
