      "ContentEnvelope": {
        "type": "object",
        "description": "Bentuk dokumentasi respons sukses satu konten (ADR-023 butir 1); isi sebenarnya `envelope::Success`.",
        "required": [
          "response_code",
          "response_description",
          "data"
        ],
        "properties": {
