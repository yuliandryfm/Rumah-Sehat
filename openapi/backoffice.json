        "summary": "Menjadwalkan draf untuk tayang (US-1101 AC2). Halaman tetap situs: versi lama berakhir saat versi baru\nmulai (US-1802 AC2); gambar tanpa teks alternatif ditolak (US-1802 AC5).",
        "operationId": "cms_content_schedule",
        "parameters": [
          {
            "name": "content_id",
            "in": "path",
            "description": "ID konten (UUID)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Konten dijadwalkan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Badan permintaan tidak dapat dibaca.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Belum login, token tidak sah, atau akun nonaktif.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Akun tanpa sub-peran Konten.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Konten tidak ada atau terhapus.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Konten bukan draf, atau versi halaman tetap lain bentrok.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Badan bukan application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Jadwal atau teks alternatif tidak valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Layanan tidak tersedia.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AttachImageRequest": {
