        "enum": [
          "article",
          "service",
          "partner",
          "product"
        ]
      },
      "MetaSchema": {
        "type": "object",
        "description": "Pagination cursor `meta` (ADR-023 butir 1), sama dengan `envelope::Meta`.",
        "required": [
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean",
            "description": "Apakah masih ada data setelah halaman ini."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor halaman berikutnya; `null` bila tidak ada."
          }
        }
      },
