              "string",
              "null"
            ],
            "description": "ID berkas gambar (bucket konten publik, disajikan lewat endpoint gambar publik bila tayang).",
            "example": "0193a1b2-c3d4-7e5f-8a6b-7c8d9e0f1a2b"
          },
          "link_target_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "link_target_type": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LinkTargetType"
              },
              {
                "type": "null"
