    "/backoffice/v1/contents": {
      "get": {
        "tags": [
          "cms"
        ],
        "summary": "Daftar konten dengan saringan status, kanal, dan halaman situs (wireframe C14).",
        "operationId": "cms_content_list",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Status tampilan; `deleted` menampilkan konten terhapus yang dapat dipulihkan.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DisplayStatus"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Kanal.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          {
            "name": "site_page",
            "in": "query",
            "description": "Halaman situs.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SitePage"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Cursor dari `meta.next_cursor` halaman sebelumnya (UUID).",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Jumlah item (1-100, bawaan 20).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar konten.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentListEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Belum login, token tidak sah, atau akun nonaktif.",
