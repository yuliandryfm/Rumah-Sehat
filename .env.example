# Contoh variabel lingkungan untuk pengembangan LOKAL Ruang Sehat.
#
# Aturan (KEPUTUSAN-88, docs/coding-standards.md §6, docs/05-stack.md §5.1):
# - Salin ke infra/local/.env (dibaca otomatis oleh `docker compose -f infra/local/compose.yaml`)
#   atau ke .env.local (pakai --env-file). Keduanya tidak di-commit (.gitignore).
# - Berkas ini hanya berisi nama variabel dan nilai contoh sintetis. Dilarang mengisi
#   rahasia asli, password, token, atau data pribadi di sini.
# - Staging dan production tidak memakai berkas .env; rahasia diambil dari OpenBao.
#
# Nama variabel ditetapkan oleh task yang membutuhkannya dan ditambahkan di sini pada task yang sama.

# Konfigurasi dasar proses backend (crate observability, F1-T10, KEPUTUSAN-132).
# LOG_LEVEL: error | warn | info | debug | trace (bawaan info).
LOG_LEVEL=info
# HTTP_BIND: alamat listen HTTP (bawaan 127.0.0.1:8080).
HTTP_BIND=127.0.0.1:8080

# --- Proses `rs-backend api` (F1-T92): database aplikasi dan validasi token realm admin ---
# Login rs_api (anggota rs_app). Password sintetis lokal; staging/production lewat OpenBao (KEPUTUSAN-79).
API_DATABASE_URL=postgres://rs_api:sintetis-lokal-pg-api@127.0.0.1:15432/ruang_sehat
# Opsional: API_DATABASE_MAX_CONNECTIONS=20 (1-100)
# Valkey aplikasi untuk cache akun dan pencabutan sesi (F1-T33); password sintetis lokal.
API_VALKEY_URL=redis://:sintetis-lokal-valkey-app@127.0.0.1:16379
# Opsional: API_VALKEY_OP_TIMEOUT_MS=250
AUTH_ADMIN_ISSUER=http://127.0.0.1:18081/realms/admin
# Saat ini hanya http://<loopback>:<port>/... (crate authn); alamat ini tidak diturunkan dari token.
AUTH_ADMIN_JWKS_URL=http://127.0.0.1:18081/realms/admin/protocol/openid-connect/certs
# Audience API backoffice; nilai final mengikuti klien audience di realm sebagai kode [TIDAK DIKETAHUI].
AUTH_ADMIN_AUDIENCE=rs-backoffice-api
# Realm pasien untuk endpoint /patient/v1 (F1-T61), pola sama dengan realm admin.
AUTH_PATIENT_ISSUER=http://127.0.0.1:18081/realms/pasien
AUTH_PATIENT_JWKS_URL=http://127.0.0.1:18081/realms/pasien/protocol/openid-connect/certs
# Audience API pasien; nilai final mengikuti klien audience di realm sebagai kode [TIDAK DIKETAHUI].
AUTH_PATIENT_AUDIENCE=rs-patient-api
# Realm korporat untuk endpoint /v1/corporate (F1-T100, ADR-027); realm sebagai kode dibuat F1-T85.
AUTH_CORPORATE_ISSUER=http://127.0.0.1:18081/realms/korporat
AUTH_CORPORATE_JWKS_URL=http://127.0.0.1:18081/realms/korporat/protocol/openid-connect/certs
# Audience API korporat; nilai final mengikuti klien audience di realm sebagai kode [TIDAK DIKETAHUI].
AUTH_CORPORATE_AUDIENCE=rs-corporate-api
# Kunci data identitas (F1-T61, KEPUTUSAN-293): dimuat dari OpenBao saat start, gagal cepat bila tidak ada.
# OPENBAO_ADDR/OPENBAO_TOKEN di bagian BFF di bawah dipakai juga oleh proses api (token dev lokal; staging/
# production memakai identitas proses api, KEPUTUSAN-79). Kunci KV berisi field "1", "2", ... (versi) dengan
# nilai base64 32 byte; buat lokal dengan: bao kv put secret/ruang-sehat/blind-index/nik 1=<base64 acak>.
NIK_BLIND_INDEX_KV_PATH=ruang-sehat/blind-index/nik
# Opsional: NIK_BLIND_INDEX_KV_MOUNT=secret, API_DEK_TRANSIT_MOUNT=transit, API_DEK_TRANSIT_KEY=rs-dek-kek
# Cache DEK di memori (wajib, tanpa nilai bawaan; nilai production [TIDAK DIKETAHUI]).
API_DEK_CACHE_TTL_SECONDS=300
API_DEK_CACHE_CAPACITY=1024
# Batas laju endpoint publik per menit (F1-T94, usulan teknis; konten dan gambar dihitung terpisah).
# Opsional: PUBLIC_RATE_LIMIT_PER_SOURCE_PER_MINUTE=300, PUBLIC_RATE_LIMIT_GLOBAL_PER_MINUTE=3000
# Proxy tepercaya (KEPUTUSAN-400, TD-22): alamat/CIDR dipisah koma. X-Forwarded-For hanya dibaca bila peer TCP
# ada di daftar (alamat paling kanan yang bukan proxy tepercaya). Tidak diset = tidak ada proxy tepercaya (lokal
# tanpa Caddy). Diset kosong atau tidak valid (prefiks 0, bit host, nama host, port) = start gagal.
# Staging/production: alamat atau jaringan Caddy di depan api (docs/05-stack.md §5.3).
# Opsional: TRUSTED_PROXY_CIDRS=172.30.0.10/32

# --- Compose lokal (F1-T07): kredensial dev, nilai sintetis ---
POSTGRES_APP_PASSWORD=sintetis-lokal-pg-app
POSTGRES_AUDIT_PASSWORD=sintetis-lokal-pg-audit
POSTGRES_RME_PASSWORD=sintetis-lokal-pg-rme
KEYCLOAK_DB_PASSWORD=sintetis-lokal-kc-db
VALKEY_APP_PASSWORD=sintetis-lokal-valkey-app
VALKEY_RME_PASSWORD=sintetis-lokal-valkey-rme
KEYCLOAK_ADMIN_USER=admin-lokal
KEYCLOAK_ADMIN_PASSWORD=sintetis-lokal-kc-admin
BAO_DEV_ROOT_TOKEN=sintetis-lokal-bao-root
S3_ACCESS_KEY=sintetis-lokal-s3-akses
# Minimal 28 karakter: backend menolak rahasia lebih pendek (OBJECT_STORAGE_SECRET_ACCESS_KEY, F1-T29).
S3_SECRET_KEY=sintetis-lokal-s3-rahasia-sintetis-lokal

# --- Berkas unggahan (F1-T29, ADR-018, KEPUTUSAN-234/235): dibaca FileStorageConfig modul platform ---
# DEPLOY_ENV: local | staging | production. Endpoint http:// hanya diterima bila local.
DEPLOY_ENV=local
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:18333
OBJECT_STORAGE_REGION=us-east-1
# path | virtual_host
OBJECT_STORAGE_ADDRESSING=path
OBJECT_STORAGE_ACCESS_KEY_ID=sintetis-lokal-s3-akses
OBJECT_STORAGE_SECRET_ACCESS_KEY=sintetis-lokal-s3-rahasia-sintetis-lokal
# Nama bucket fisik = awalan + bucket logis (identity-document, clinical, ...); dibuat lebih dulu (versi aktif).
OBJECT_STORAGE_BUCKET_PREFIX=rs-local-
# Opsional: OBJECT_STORAGE_TIMEOUT_SECONDS=10, UPLOAD_SLOT_TTL_SECONDS=600 (60-3600),
# UPLOAD_METHOD=post (post|put), FILE_VALIDATION_CONCURRENCY=2 (1-4),
# FILE_VALIDATION_QUEUE_TIMEOUT_SECONDS=10 (1-60)

# --- Realm Keycloak sebagai kode (F1-T31): nilai $(env:...) di infra/keycloak/realms/*.json ---
# SMTP realm mengarah ke relay internal ADR-026 (`rs-backend email-relay`, F1-T36) dengan STARTTLS wajib.
# Compose lokal belum memuat layanan relay; tanpa relay, pengiriman email Keycloak gagal (aman: tidak ada email
# keluar). Jalur email end-to-end diuji `bash scripts/keycloak-check.sh ephemeral`.
RS_KC_SMTP_HOST=email-relay
RS_KC_SMTP_PORT=2525
RS_KC_SMTP_FROM=noreply@ruangsehat.invalid
# Redirect URI klien (lokal). Skema aplikasi mobile final ditetapkan bersama F1-T47.
RS_KC_PASIEN_MOBILE_REDIRECT_URI=com.example.ruangsehat.pasien:/oauth2redirect
RS_KC_BACKOFFICE_BFF_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
RS_KC_PORTAL_BFF_REDIRECT_URI=http://127.0.0.1:3001/auth/callback
# Realm korporat (F1-T85): BFF web/korporat; port lokal final mengikuti F1-T90 [TIDAK DIKETAHUI].
RS_KC_KORPORAT_BFF_REDIRECT_URI=http://127.0.0.1:3002/auth/callback
# Secret klien BFF (sintetis, lokal saja). Staging/production: dari OpenBao, tidak pernah di repo.
RS_KC_BACKOFFICE_BFF_SECRET=sintetis-lokal-kc-backoffice-bff
RS_KC_PORTAL_BFF_SECRET=sintetis-lokal-kc-portal-bff
RS_KC_KORPORAT_BFF_SECRET=sintetis-lokal-kc-korporat-bff
# Klien layanan pengambil event rs-backend worker (F1-T34, ADR-011 butir 10): satu rahasia per realm
# (sintetis, lokal saja). Proses `rs-backend worker` membacanya sebagai KEYCLOAK_EVENT_SECRET_PASIEN/_ADMIN/_KORPORAT (realm bawaan sejak F1-T109),
# bersama WORKER_DATABASE_URL (login rs_worker) dan KEYCLOAK_ADMIN_URL (http://127.0.0.1:<KEYCLOAK_PORT>).
RS_KC_EVENT_READER_PASIEN_SECRET=sintetis-lokal-kc-event-reader-pasien
RS_KC_EVENT_READER_ADMIN_SECRET=sintetis-lokal-kc-event-reader-admin
RS_KC_EVENT_READER_KORPORAT_SECRET=sintetis-lokal-kc-event-reader-korporat
# TD-27: worker juga menyalin pencabutan sesi dari event LOGOUT Keycloak ke Valkey aplikasi yang sama dengan
# API_VALKEY_URL, dibaca sebagai WORKER_VALKEY_URL (opsional WORKER_VALKEY_OP_TIMEOUT_MS).
# Klien layanan pengelola pengguna admin (F1-T65, US-208): `rs-backend api` dan perintah
# `rs-backend bootstrap-super-admin` membacanya sebagai KEYCLOAK_ADMIN_MANAGER_SECRET (sintetis, lokal saja).
RS_KC_ADMIN_MANAGER_SECRET=sintetis-lokal-kc-admin-manager
# Klien layanan worker IdP realm korporat (ADR-030, CR-026): rahasia yang sama disimpan di KV OpenBao lokal
# (IDP_WORKER_KV_PATH_KORPORAT, field client_secret) dan dibaca `rs-backend worker` bila IDP_WORKER_REALMS=korporat.
RS_KC_IDP_WORKER_KORPORAT_SECRET=sintetis-lokal-kc-idp-worker-korporat

# --- BFF server Next.js backoffice (F1-T41, @rs/bff-auth; ADR-011 butir 7, ADR-024 butir 3) ---
# Rahasia BFF TIDAK di sini: secret klien OIDC, kunci sesi, dan password Valkey dibaca dari OpenBao KV v2
# (BFF_OPENBAO_KV_MOUNT/BFF_OPENBAO_KV_PATH; bentuk rahasia di web/packages/bff-auth/README.md).
# OPENBAO_TOKEN lokal = token dev (identitas proses BFF di staging/production, KEPUTUSAN-79).
BFF_APP_NAME=backoffice
BFF_APP_ORIGIN=http://127.0.0.1:3000
BFF_OIDC_ISSUER=http://127.0.0.1:18081/realms/admin
BFF_OIDC_CLIENT_ID=rs-backoffice-bff
BFF_OIDC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
BFF_API_BASE_URL=http://127.0.0.1:8080
# Opsional (F1-T95): origin object storage untuk unggah gambar CMS dari browser (masuk connect-src CSP backoffice; hanya origin, https; http hanya development). Lokal: http://127.0.0.1:18333
# BACKOFFICE_UPLOAD_ORIGIN=
BFF_VALKEY_URL=redis://127.0.0.1:16379/0
OPENBAO_ADDR=http://127.0.0.1:18200
OPENBAO_TOKEN=sintetis-lokal-bao-root
BFF_OPENBAO_KV_MOUNT=secret
BFF_OPENBAO_KV_PATH=rs/bff/backoffice

# --- Web korporat (F1-T103, web/korporat) ---
# Opsional: origin object storage untuk unggah dokumen perusahaan dari browser (masuk connect-src CSP korporat).
# Format: hanya origin `https://<host>[:port]` tanpa path, query, kredensial, wildcard, atau spasi; `http` hanya
# diterima saat development. Nilai lain diabaikan (unggah dokumen tidak jalan, CSP tidak melonggar). Lokal: http://127.0.0.1:18333
# KORPORAT_UPLOAD_ORIGIN=

# --- Relay email ADR-026 (F1-T36): `rs-backend email-relay`, satu instans per host ---
# Tidak ada kredensial AWS di berkas ini: kunci akses SES dibaca dari OpenBao KV v2 (field access_key_id,
# secret_access_key) dengan token proses relay. SES_LOCAL_ENDPOINT (tiruan SES HTTPS) hanya diterima bila
# DEPLOY_ENV=local; tanpa itu relay memakai email.ap-southeast-3.amazonaws.com.
# EMAIL_RELAY_BIND=127.0.0.1:2525
# EMAIL_RELAY_HOSTNAME=email-relay
# EMAIL_RELAY_TLS_CERT_FILE=/run/ruang-sehat/email-relay/cert.pem
# EMAIL_RELAY_TLS_KEY_FILE=/run/ruang-sehat/email-relay/key.pem
# EMAIL_RELAY_ALLOWED_FROM=noreply@ruangsehat.invalid
# Opsional: EMAIL_RELAY_MAX_MESSAGE_BYTES=262144, EMAIL_RELAY_GLOBAL_PER_MINUTE=60,
# EMAIL_RELAY_PER_RECIPIENT_PER_HOUR=5, EMAIL_RELAY_MAX_CONNECTIONS=16, EMAIL_RELAY_IDLE_TIMEOUT_SECS=30,
# EMAIL_RELAY_SESSION_TIMEOUT_SECS=120, SES_TIMEOUT_MS=8000 (maks 9000), SES_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# SES_CONFIGURATION_SET=rs-keycloak-local
# OPENBAO_ADDR=http://127.0.0.1:18200
# OPENBAO_TOKEN=<token proses relay; jangan isi rahasia asli di sini>
# SES_CREDENTIALS_KV_MOUNT=secret
# SES_CREDENTIALS_KV_PATH=ruang-sehat/ses/email-relay

# Port host (opsional; semua terikat ke 127.0.0.1)
# POSTGRES_APP_PORT=15432
# POSTGRES_AUDIT_PORT=15433
# POSTGRES_RME_PORT=15434
# VALKEY_APP_PORT=16379
# VALKEY_RME_PORT=16380
# KEYCLOAK_PORT=18081
# OPENBAO_PORT=18200
# SWAGGER_UI_PORT=18082
# S3_PORT=18333
# Folder data emulator S3 (bind mount, di luar repo; buat dulu dengan mkdir -p):
# RS_OBJECT_STORAGE_DIR=${HOME}/ruang-sehat-data/object-storage
